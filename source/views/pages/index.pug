extends ../layout

block content

  .home-hero.mb-5
    .hero-content.text-center
      h1.display-4.fw-light.mb-3
        | Bienvenido a 
        span.fw-semibold Fotaza 2

      p.lead.text-muted.mb-4
        | Una comunidad para compartir tus imágenes.

      if !usuarioLogueado
        .d-flex.justify-content-center.gap-3
          button.btn.btn-dark.btn-lg.rounded-pill.px-4(
            type="button"
            data-bs-toggle="modal"
            data-bs-target="#modalRegistro"
          ) Empezar ahora

          button.btn.btn-outline-secondary.btn-lg.rounded-pill.px-4(
            type="button"
            data-bs-toggle="modal"
            data-bs-target="#modalIniciarSesion"
          ) Ya tengo cuenta

  if usuarioLogueado
    .d-flex.justify-content-between.align-items-center.mb-4
      h5.fw-semibold.mb-0
        | Publicaciones recientes

      small.text-muted
        | Hola de nuevo, #{usuarioLogueado.nombre_usuario}

  .row.g-4
    each pub in publicaciones
      include ../partials/card.publicacion.pug

  nav.mt-5(aria-label="Paginación de publicaciones")
    ul.pagination.justify-content-center

      li.page-item.disabled
        a.page-link(href="#" tabindex="-1") ←

      li.page-item.active
        a.page-link(href="#") 1

      li.page-item
        a.page-link(href="#") 2

      li.page-item
        a.page-link(href="#") 3

      li.page-item
        a.page-link(href="#") →