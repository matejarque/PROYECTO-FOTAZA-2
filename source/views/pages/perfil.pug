extends ../layout

block content
  .container.mt-4.perfil-container

    // HEADER PERFIL
    .perfil-header

      .perfil-avatar
        img(src="/img/default-avatar.jpg")

      .perfil-info
        .perfil-top
          h3 @#{usuarioLogueado.nombre}
          button.btn.btn-sm.btn-outline-primary Editar perfil

        .perfil-stats
          div
            strong #{cantidadPublicaciones || 0}
            span Publicaciones
          div
            strong #{cantidadSeguidores || 0}
            span Seguidores
          div
            strong #{cantidadSeguidos || 0}
            span Seguidos

        p.perfil-bio #{usuarioLogueado.bio || "Esta es la descripcion."}

    hr

    // TABS
    .perfil-tabs
      a(href="/perfil?seccion=publicaciones" class=seccion==="publicaciones"?"active":"") Publicaciones
      a(href="/perfil?seccion=seguidos" class=seccion==="seguidos"?"active":"") Seguidos
      a(href="/perfil?seccion=colecciones" class=seccion==="colecciones"?"active":"") Colecciones
      a(href="/perfil?seccion=intereses" class=seccion==="intereses"?"active":"") Intereses
      a(href="/perfil?seccion=chat" class=seccion==="chat"?"active":"") Chat

    // CONTENIDO
    .row

      if seccion === "colecciones"
        h4 Mis colecciones
        .col-12
          .alert.alert-info.text-center.mt-3 No tienes colecciones

      else if seccion === "intereses"
        h4 Imágenes que me interesan adquirir

        if intereses && intereses.length > 0
          each img in intereses
            p Imagen interesada
        else
          .col-12
            .alert.alert-info.text-center.mt-3 No tienes intereses

      else if seccion === "chat"
        h4 Chats

        if chats && chats.length > 0
          each chat in chats
            p Chat con #{chat.usuario}
        else
          .col-12
            .alert.alert-info.text-center.mt-3 No tienes chats

      else if seccion === "seguidos"
        h4 Publicaciones de personas que seguis

        if publicacionesSeguidos && publicacionesSeguidos.length > 0
          each pub in publicacionesSeguidos
            include ../partials/card.publicacion.pug
        else
          .col-12
            .alert.alert-info.text-center.mt-3 No sigues a nadie o aun nadie publica

      else
        h4 Mis publicaciones

        if misPublicaciones && misPublicaciones.length > 0
          each pub in misPublicaciones
            include ../partials/card.publicacion.pug
        else
          .col-12
            .alert.alert-info.text-center.mt-3 No tienes publicaciones
            
            button.btn.btn-success.mt-2(type="button" data-bs-toggle="modal"  data-bs-target="#modalCrearPublicacion") Crear primera publicacion