extends ../layout

block content

  .perfil-container

    .perfil-header

      .perfil-avatar
        img(src=usuarioLogueado.foto_perfil || "/img/default-avatar.jpg")

      .perfil-info

        .perfil-top
          h3 @#{usuarioLogueado.nombre_usuario}

          button.btn.btn-sm.btn-outline-primary Editar perfil

        .perfil-stats

          .stat
            strong #{cantidadPublicaciones || 0}
            span Publicaciones

          .stat
            strong #{cantidadSeguidores || 0}
            span Seguidores

          .stat
            strong #{cantidadSeguidos || 0}
            span Seguidos

        p.perfil-bio
          | #{usuarioLogueado.bio || "Sin descripción"}

    hr

    .perfil-tabs

      a(
        href="/perfil?seccion=publicaciones"
        class=seccion==="publicaciones" ? "active" : ""
      ) Publicaciones

      a(
        href="/perfil?seccion=seguidos"
        class=seccion==="seguidos" ? "active" : ""
      ) Seguidos

      a(
        href="/perfil?seccion=colecciones"
        class=seccion==="colecciones" ? "active" : ""
      ) Colecciones

      a(
        href="/perfil?seccion=intereses"
        class=seccion==="intereses" ? "active" : ""
      ) Intereses

      a(
        href="/perfil?seccion=chat"
        class=seccion==="chat" ? "active" : ""
      ) Chat

    .row.g-4.mt-2

      if seccion === "seguidos"

        if publicacionesSeguidos && publicacionesSeguidos.length > 0

          each pub in publicacionesSeguidos
            include ../partials/card.publicacion.pug

        else

          .col-12
            .alert.alert-dark.text-center Aun no seguis a nadie

      else

        if misPublicaciones && misPublicaciones.length > 0

          each pub in misPublicaciones
            include ../partials/card.publicacion.pug

        else

          .col-12.text-center
            .alert.alert-dark
              | No tienes publicaciones

            button.btn.btn-success.mt-2(type="button" data-bs-toggle="modal" data-bs-target="#modalCrearPublicacion") Crear primera publicación