extends ../layout

block content

  .perfil-container
    .perfil-header
      .perfil-avatar
        img(src=usuario.foto_perfil || "/img/default-avatar.jpg")

      .perfil-info
        .perfil-top
          h3 @#{usuario.nombre_usuario}

        .perfil-stats
          .stat
            strong #{cantidadPublicaciones || 0}
            span Publicaciones

          .stat
            strong #{cantidadSeguidores || 0}
            span Seguidores

          .stat
            strong #{cantidadSeguidos || 0} 
            span Seguidos

        p.perfil-bio #{usuario.bio || "Sin descripción"}

    hr

    h4.mb-4 Publicaciones

    .row.g-4

      if publicaciones && publicaciones.length > 0

        each pub in publicaciones
          include ../partials/card.publicacion.pug

      else

        .col-12
          .alert.alert-dark.text-center
            | Este usuario aun no tiene publicaciones