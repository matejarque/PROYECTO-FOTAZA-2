#modalCrearPublicacion.modal.fade(tabindex="-1")
  .modal-dialog
    .modal-content

      .modal-header
        h5.modal-title Crear publicación
        button.btn-close(type="button" data-bs-dismiss="modal")

      .modal-body
        form#formCrearPublicacionNueva(action="/publicaciones/crear" method="POST" enctype="multipart/form-data")

          input.form-control.mb-2(type="text" name="titulo" placeholder="Título" required)

          textarea.form-control.mb-2(name="descripcion" placeholder="Descripción" required)

          // ==========================================================================
          // SELECCION DE CATEGORIA
          // ==========================================================================
          select.form-select.mb-2(name="idCategoria" required)
            option(value="") Selecciona una categoría
            if listaCategoriasGlobal
              each cat in listaCategoriasGlobal
                option(value=cat.id_categoria) #{cat.nombre_categoria}

          select.form-select.mb-2(name="idLicencia" required)
            option(value="") Selecciona una licencia
            option(value="4") Sin copyright
            option(value="1") Con copyright 
            option(value="2") Creative Commons

          // Input multiple //me cargaba una imagen, luego pasar a un .js
          input.form-control.mb-3(type="file" name="imagenes" multiple accept="image/*,video/*" required)

          input.form-control.mb-2(type="text" name="marcaAgua" placeholder="Marca de agua (opcional)")

          button.btn.btn-success.w-100(type="submit") Publicar