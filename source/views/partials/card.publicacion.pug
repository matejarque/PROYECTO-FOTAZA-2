.col-12.col-sm-6.col-md-4
  .card.shadow-sm.h-100.publicacion-card.hover-shadow

    // =========================
    // BODY
    // =========================
    .card-body
      .d-flex.align-items-center.mb-3
        a.usuario-link.d-flex.align-items-center.text-decoration-none(href=`/perfil/${pub.id_usuario}`)
          img.avatar-mini.me-2(src="/img/default-avatar.jpg" alt="Avatar")
          span.small.fw-bold.text-primary @#{pub.nombre_usuario}

      h6.card-title.mb-2 #{pub.titulo}
      p.card-text.text-muted.small.mb-3 #{pub.descripcion}

    // =========================
    // CARRUSEL CON VALORACIONES
    // =========================
    .carousel.slide(id=`carrusel-${pub.id_publicacion}` data-bs-ride="false")

      if pub.imagenes && pub.imagenes.length > 1
        .carousel-indicators
          each img, i in pub.imagenes
            button(type="button" data-bs-target=`#carrusel-${pub.id_publicacion}` data-bs-slide-to=i class=i === 0 ? "active" : "")

      .carousel-inner
        if pub.imagenes && pub.imagenes.length > 0
          each img, i in pub.imagenes
            .carousel-item(class=i === 0 ? "active" : "")
              .position-relative.media-contenedor
                if img.ruta_url && (img.ruta_url.includes('.mp4') || img.ruta_url.includes('.mov') || img.ruta_url.includes('.avi'))
                  video.d-block.w-100.media-render(controls)
                    source(src=img.ruta_url type="video/mp4")
                else
                  img.d-block.w-100.media-render(src=img.ruta_url || "/img/default-avatar.jpg" alt="Contenido")
                
                .position-absolute.top-0.end-0.bg-dark.text-white.bg-opacity-75.m-2.p-1.px-2.rounded.small
                  | ⭐ #{img.promedio}/5 (#{img.votos} votos)

              .p-2.bg-light.border-bottom.d-flex.justify-content-between.align-items-center.barra-puntuacion
                span.text-muted.small Imagen ##{i + 1}
                button.btn.btn-xs.btn-outline-primary.py-0.btn-puntuar-foto(
                  type="button"
                  data-id-imagen=img.id_imagen
                  data-id-autor=pub.id_usuario
                  data-id-logueado=usuarioLogueado ? usuarioLogueado.id : ""
                ) ⭐ Puntuar esta foto

            // MODAL DINÁMICO DE VALORACIÓN PARA CADA IMAGEN (Evita el error 404)
            .modal.fade(id=`modalValorar-${img.id_imagen}` tabindex="-1" aria-hidden="true")
              .modal-dialog.modal-dialog-centered.modal-sm
                .modal-content
                  .modal-header
                    h6.modal-title Puntuar Imagen ##{i + 1}
                    button.btn-close(type="button" data-bs-dismiss="modal")
                  .modal-body.text-center
                    form.form-puntuar(data-id-imagen=img.id_imagen)
                      .mb-3
                        label.form-label.fw-bold Elige una puntuación:
                        select.form-select.select-puntuacion(required)
                          option(value="5") ⭐⭐⭐⭐⭐ (5)
                          option(value="4") ⭐⭐⭐⭐ (4)
                          option(value="3") ⭐⭐⭐ (3)
                          option(value="2") ⭐⭐ (2)
                          option(value="1") ⭐ (1)
                      button.btn.btn-sm.btn-primary.w-100(type="submit") Enviar Puntuación
        else
          .carousel-item.active
            .position-relative.media-contenedor
              img.d-block.w-100.media-render(src="/img/default-avatar.jpg" alt="Imagen por defecto")

      if pub.imagenes && pub.imagenes.length > 1
        button.carousel-control-prev(type="button" data-bs-target=`#carrusel-${pub.id_publicacion}` data-bs-slide="prev")
          span.carousel-control-prev-icon
          span.visually-hidden Anterior
        button.carousel-control-next(type="button" data-bs-target=`#carrusel-${pub.id_publicacion}` data-bs-slide="next")
          span.carousel-control-next-icon
          span.visually-hidden Siguiente

    // =========================
    // FOOTER BOTONES GENERALES
    // =========================
    .card-footer.bg-white.border-top-0.pt-3
      .d-flex.justify-content-between.gap-1.mb-2
        button.btn.btn-sm.btn-outline-secondary.flex-fill.btn-trigger-comentarios(
          type="button" 
          data-bs-toggle="collapse" 
          data-bs-target=`#comentarios-${pub.id_publicacion}`
        ) 💬 Comentar #{usuarioLogueado && pub.comentarios ? `(${pub.comentarios.length})` : ''}
        
        button.btn.btn-sm.btn-outline-success.flex-fill.btn-interes(type="button" data-id-pub=pub.id_publicacion) ✨ Interés

      if usuarioLogueado
        .d-grid
          button.btn.btn-sm.btn-link.text-danger.text-decoration-none.btn-abrir-reporte(
            type="button" 
            data-bs-toggle="modal" 
            data-bs-target="#modalReportar"
            data-id-publicacion=pub.id_publicacion
          ) 🚩 Reportar contenido

    // ========================
    // INCLUDES
    // ========================
    include ./comentarios.pug