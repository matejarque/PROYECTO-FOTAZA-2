.col-12.col-sm-6.col-md-4
  .card.shadow-sm.h-100.publicacion-card.hover-shadow

    // =========================
    // BODY
    // =========================
    .card-body
      .d-flex.align-items-center.mb-3
        a.usuario-link.d-flex.align-items-center.text-decoration-none(href=`/perfil/${pub.id_usuario}`)
          img.avatar-mini.me-2(src="/img/default-avatar.jpg" alt="Avatar" style="width:30px; height:30px; border-radius:50%; object-fit:cover;")
          span.small.fw-bold.text-primary @#{pub.nombre_usuario}

      h6.card-title.mb-2
        | #{pub.titulo}

      p.card-text.text-muted.small.mb-3
        | #{pub.descripcion}

    // =========================
    // CARRUSEL CON VALORACIONES POR IMAGEN
    // =========================
    .carousel.slide(id=`carrusel-${pub.id_publicacion}` data-bs-ride="false")

      if pub.imagenes && pub.imagenes.length > 1
        .carousel-indicators
          each img, i in pub.imagenes
            button(type="button" data-bs-target=`#carrusel-${pub.id_publicacion}` data-bs-slide-to=i class=i === 0 ? "active" : "")

      .carousel-inner
        if pub.imagenes && pub.imagenes.length > 0
          each img, i in pub.imagenes
            .carousel-item(class=i === 0 ? "active" : "")
              // Contenedor relativo para posicionar las estrellas sobre la imagen
              .position-relative
                img.d-block.w-100(src=img.ruta_url alt="Imagen" loading="lazy" style="height:250px; object-fit:cover;")
                
                // Badge flotante con la puntuación de ESTA imagen específica
                .position-absolute.top-0.end-0.bg-dark.text-white.bg-opacity-75.m-2.p-1.px-2.rounded.small
                  | ⭐ #{img.promedio}/5 (#{img.votos} votos)

              // Bloque de acciones específicas para ESTA imagen si está logueado
              .p-2.bg-light.border-bottom.d-flex.justify-content-between.align-items-center
                span.text-muted.small Imagen ##{i + 1}
                if usuarioLogueado
                  // Validamos que el usuario no sea el autor de la publicación antes de dejarlo puntuar
                  if usuarioLogueado.id !== pub.id_usuario
                    button.btn.btn-xs.btn-outline-primary.py-0(type="button" data-bs-toggle="modal" data-bs-target=`#modalValorar-${img.id_imagen}`) ⭐ Puntuar esta foto
                  else
                    span.text-muted.small.text-danger (Tu publicación)
                else
                  button.btn.btn-xs.btn-outline-primary.py-0(type="button" data-bs-toggle="modal" data-bs-target="#modalCheck") ⭐ Puntuar
        else
          .carousel-item.active
            img.d-block.w-100(src="/img/default-avatar.jpg" alt="Imagen" loading="lazy" style="height:250px; object-fit:cover;")

      if pub.imagenes && pub.imagenes.length > 1
        button.carousel-control-prev(type="button" data-bs-target=`#carrusel-${pub.id_publicacion}` data-bs-slide="prev")
          span.carousel-control-prev-icon
          span.visually-hidden Anterior
        button.carousel-control-next(type="button" data-bs-target=`#carrusel-${pub.id_publicacion}` data-bs-slide="next")
          span.carousel-control-next-icon
          span.visually-hidden Siguiente

    // =========================
    // FOOTER BOTONES GENERALES
    // =========================
    .card-footer.bg-white.border-top-0.pt-3
      if usuarioLogueado
        .d-flex.justify-content-between.gap-1.mb-2
          button.btn.btn-sm.btn-outline-secondary.flex-fill(type="button" data-bs-toggle="collapse" data-bs-target=`#comentarios-${pub.id_publicacion}`) 💬 Comentar (#{pub.comentarios ? pub.comentarios.length : 0})
          button.btn.btn-sm.btn-outline-success.flex-fill(type="button") ✨ Interés

        .d-grid
          button.btn.btn-sm.btn-link.text-danger.text-decoration-none(type="button" data-bs-toggle="modal" data-bs-target="#modalReportar") 🚩 Reportar contenido
      else
        .d-flex.justify-content-between.gap-1.mb-2
          button.btn.btn-sm.btn-outline-secondary.flex-fill(type="button" data-bs-toggle="modal" data-bs-target="#modalCheck") 💬 Comentar
          button.btn.btn-sm.btn-outline-success.flex-fill(type="button" data-bs-toggle="modal" data-bs-target="#modalCheck") ✨ Interés

    // =========================
    // INCLUDES (Generamos los modales de valoración recorriendo las imágenes de la publicación)
    // =========================
    include ./comentarios.pug
    if pub.imagenes && pub.imagenes.length > 0
      each img in pub.imagenes
        // Pasamos la variable 'img' explícitamente al modal para renderizar uno por imagen
        include ./modal.valoracion.pug