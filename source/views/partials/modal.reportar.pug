#modalReportar.modal.fade(tabindex="-1")
  .modal-dialog.modal-dialog-centered
    .modal-content
      .modal-header
        h5.modal-title Reportar publicación 
        button.btn-close(type="button" data-bs-dismiss="modal")

      .modal-body
        p ¿Cual es el motivo del reporte?

        select#selectMotivoDenuncia.form-select.mb-3
          option(value="" disabled selected) Selecciona un motivo...
          option(value="1") Spam
          option(value="2") Contenido ofensivo
          option(value="3") Contenido inapropiado
          option(value="4") Otro

      .modal-footer
        button.btn.btn-secondary(type="button" data-bs-dismiss="modal") Cancelar
        button#btnConfirmarReporte.btn.btn-danger(type="button" data-id-publicacion="") Enviar reporte