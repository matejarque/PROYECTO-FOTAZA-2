#modalReportar.modal.fade(tabindex="-1")
  .modal-dialog.modal-dialog-centered
    .modal-content

      .modal-header
        h5.modal-title Reportar contenido
        button.btn-close(type="button" data-bs-dismiss="modal")

      .modal-body

        input#idPublicacionReporte(type="hidden")
        input#idComentarioReporte(type="hidden")

        p ¿Cual es el motivo del reporte?

        select#motivoReporte.form-select.mb-3
         option(value="") Cargando motivos

      .modal-footer
        button.btn.btn-secondary(
          type="button"
          data-bs-dismiss="modal"
        ) Cancelar

        button#btnEnviarReporte.btn.btn-danger(
          type="button"
        ) Enviar reporte